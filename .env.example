# Create a key at https://platform.cheaperinference.com
CHEAPER_INFERENCE_API_KEY=ci_live_your_key_here

# Added automatically when you connect Neon and Blob in the Vercel dashboard.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Create a Vercel access token that can manage this project to enable custom domains.
VERCEL_API_TOKEN=your_vercel_access_token
VERCEL_PROJECT_ID=prj_your_project_id
VERCEL_TEAM_ID=team_your_team_id

# Stripe Checkout collects payment before Freeable purchases a domain.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
NEXT_PUBLIC_DOMAIN_CHECKOUT_ENABLED=false

# The CNAME value shown in the Vercel project's Domains settings.
NEXT_PUBLIC_DOMAIN_TARGET=cname.vercel-dns.com

# Attach *.sites.example.com to the Vercel project for free customer subdomains.
NEXT_PUBLIC_FREE_SITE_DOMAIN=sites.example.com

# Comma-separated production hostnames that should show the Freeable builder.
BUILDER_HOSTS=freeable.example.com
SITE_URL=https://freeable.example.com
NEXT_PUBLIC_SITE_ORIGIN=https://freeable.example.com
